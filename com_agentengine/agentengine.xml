<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
  <name>com_agentengine</name>
  <creationDate>2025-01-28</creationDate>
  <author>Jules</author>
  <copyright>(C) 2025 AgentEngine. All rights reserved.</copyright>
  <license>GNU General Public License version 2 or later</license>
  <authorEmail>info@example.com</authorEmail>
  <authorUrl>www.example.com</authorUrl>
  <version>1.1.0</version>
  <description>AI-powered Agent Engine for Joomla 5 - Enabling intelligent automation with Development Action Taking, Code Generation, DOM Intelligence, Chat, and Maintainer agents</description>

  <!-- PSR-4: Combined with manual loading in provider.php -->
  <namespace path="src">Jules\Component\AgentEngine\Administrator</namespace>

  <administration>
    <menu>Agent Engine</menu>
    <files folder="admin">
      <folder>forms</folder>
      <folder>language</folder>
      <folder>services</folder>
      <folder>src</folder>
      <folder>sql</folder>
      <folder>tmpl</folder>
    </files>
    <languages folder="admin/language">
        <language tag="en-GB">en-GB/en-GB.com_agentengine.ini</language>
    </languages>
  </administration>

  <install>
    <sql>
      <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
    </sql>
  </install>
  <uninstall>
    <sql>
      <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
    </sql>
  </uninstall>
</extension>
